# Copie ce fichier en `.env` en local, et configure les mêmes variables dans
# Render (Dashboard -> service pulse-backend -> Environment).

# Requis. URL de connexion Postgres.
DATABASE_URL=

# Requis en production. Sans cette variable, le serveur génère un secret
# aléatoire à CHAQUE démarrage (server.js ligne ~27) : tous les tokens JWT déjà
# émis deviennent invalides au redémarrage suivant (déploiement, crash, ou
# simple reveil apres mise en veille sur le plan gratuit Render), déconnectant
# silencieusement tous les utilisateurs. Génère une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optionnel, Render le fournit automatiquement.
PORT=3000
